# Required. At least 32 characters. Generate with: openssl rand -base64 48
APP_SECRET=

# Required. Path to the SQLite file.
DATABASE_PATH=./data/walley.db

# Optional. Port to listen on, 1 to 65535.
PORT=3000

# Optional. Address to bind. Docker deployments set 0.0.0.0 in compose.
HOST=127.0.0.1

# Optional. Set to true to allow new accounts to be created.
ALLOW_REGISTRATION=false

# Optional. Uncomment only for built or Docker runs: serves the built web app from dist/web.
# Leave unset for development, where Vite serves the web app.
# NODE_ENV=production

# OIDC: set all four or none
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=

# Docker deployment (compose only). Used by compose.example.yml, not by local dev.
# Set these in .env before copying compose.example.yml to compose.yml.
# e.g. walley.example.com
WALLEY_HOSTNAME=
# e.g. https://<traefik LAN IP>
DOCKFLARE_SERVICE=
# TZ=Etc/UTC
# compose.example.yml overrides DATABASE_PATH, PORT and HOST inside the container.
