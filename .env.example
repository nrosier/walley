# Required. At least 32 characters. Generate with: openssl rand -base64 48
APP_SECRET=

# Required. Path to the SQLite file. Walley creates the parent folder and the file,
# and runs the database migrations at start.
DATABASE_PATH=./data/walley.db

# Required. Folder for per-user Actual Budget data. Walley creates DATA_DIR/actual/<userId> for each user.
DATA_DIR=./data

# Required. Public origin that users open in the browser. Use https, or http only for localhost, 127.0.0.1 or [::1]. Walley exits at startup if it is missing or invalid.
# Local development must use the Vite dev origin, http://127.0.0.1:5173 (port 5173 in vite.config.ts).
# Replace the example value with your own public origin before you start Walley.
PUBLIC_ORIGIN=https://walley.example.com

# Optional. Port to listen on, 1 to 65535.
PORT=3000

# Optional. Address to bind. Docker deployments set 0.0.0.0 in compose.
HOST=127.0.0.1

# Optional. Set to true to allow new accounts to be created. Local mode also needs SMTP_URL and MAIL_FROM.
ALLOW_REGISTRATION=false

# Required in local mode when ALLOW_REGISTRATION=true. SMTP URL for verification mail.
# Use smtp: or smtps:. The URL can hold credentials: never commit a real one.
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Required in local mode when ALLOW_REGISTRATION=true. From address on verification mail.
# MAIL_FROM=walley@example.com

# Optional. Comma-separated IP addresses or CIDR ranges of the reverse proxies in front of Walley,
# for example 172.18.0.0/16,::1. Walley trusts X-Forwarded-For only from these addresses.
# Leave unset when Walley is reached directly.
# List only the addresses of those proxies, never a client network.
# The proxy must append the real client address to X-Forwarded-For, or overwrite it.
# Walley trusts the entry added by the nearest untrusted hop.
# Any client inside a trusted range can forge its address and get past the per-IP rate limit.
# Ranges: IPv4 prefix at least /8, IPv6 at least /32, no zone IDs (%), and no host bits
# (write 10.0.0.0/8, not 10.0.0.1/8).
# TRUST_PROXY=

# Optional. Uncomment only for built or Docker runs: serves the built web app from dist/web.
# Leave unset for development, where Vite serves the web app.
# NODE_ENV=production

# Wallos and Actual Budget connection details are NOT environment variables. Each signed-in
# user enters them on the Settings page, and Walley stores them encrypted in the database:
#   Wallos:  URL and API key (sent to <url>/api/subscriptions/get_subscriptions.php as a form field).
#   Actual:  server URL, server password, budget (Sync ID), and the budget's end-to-end
#            encryption password if the budget is encrypted (leave it empty otherwise).
# DATA_DIR above holds the per-user Actual cache. Exactly one Walley process may use it.

# OIDC: set all four or none. Walley requests the openid and email scopes.
# OIDC_CALLBACK_URL must end in /api/auth/oidc/callback and use the PUBLIC_ORIGIN host.
# Linking an existing account needs email_verified: true in the ID token.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=

# Docker deployment (compose only). Used by compose.example.yml, not by local dev.
# Set these in .env before copying compose.example.yml to compose.yml.
# e.g. walley.example.com
WALLEY_HOSTNAME=
# e.g. https://<traefik LAN IP>
DOCKFLARE_SERVICE=
# TZ=Etc/UTC
# compose.example.yml overrides DATABASE_PATH, DATA_DIR, PORT and HOST inside the container.
