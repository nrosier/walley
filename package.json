{
  "name": "walley",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:server": "tsc -p src/server/tsconfig.build.json && node -e \"require('node:fs').cpSync('src/server/db/migrations','dist/server/db/migrations',{recursive:true})\"",
    "build:web": "vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/lib && tsc --noEmit -p src/server && tsc --noEmit -p src/web",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:cleanup-unverified": "tsx scripts/cleanup-unverified-passwords.ts",
    "seed:test-data": "tsx scripts/seed-test-data.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "lucide-react": "1.65.0",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jose": "6.2.14",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
